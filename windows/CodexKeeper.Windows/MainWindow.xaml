<Window x:Class="CodexKeeper.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Keeper" Width="1100" Height="960" MinWidth="960" MinHeight="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SubtleText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="QuotaBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Background" Value="#EAF0ED" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
              <Grid x:Name="PART_Track">
                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <Grid Margin="18,16,18,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="2,0,2,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource Accent}" VerticalAlignment="Center">
            <TextBlock Text="K" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding AppTitle}" FontSize="22" FontWeight="Bold" />
              <Border Background="{StaticResource AccentLight}" CornerRadius="7" Padding="8,4" Margin="10,0,0,0">
                <TextBlock Text="{Binding WindowsBadge}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding AppTagline}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="13,9" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding KeeperSettingsTitle}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding KeeperExplanation}" Style="{StaticResource SubtleText}" Margin="0,6,0,8" />
            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding KeeperEnableLabel}" />
            <CheckBox IsChecked="{Binding AutoResume, Mode=TwoWay}" Content="{Binding AutoResumeLabel}" Margin="0,8,0,0" />
            <CheckBox IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" Content="{Binding StartupLabel}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="{Binding QuotaTitle}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding LastSyncLine}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Row="0" Grid.Column="1" Content="{Binding SyncLabel}" Style="{StaticResource QuietButton}" Click="Refresh_Click" />
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
              <DockPanel LastChildFill="True">
                <TextBlock Text="{Binding FiveHourTitle}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding FiveHourText}" Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <ProgressBar Style="{StaticResource QuotaBar}" Value="{Binding FiveHourProgress, Mode=OneWay}" Maximum="100" Margin="0,6,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
              <DockPanel LastChildFill="True">
                <TextBlock Text="{Binding WeeklyTitle}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding WeeklyText}" Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <ProgressBar Style="{StaticResource QuotaBar}" Value="{Binding WeeklyProgress, Mode=OneWay}" Maximum="100" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding ProjectsTitle}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding ProjectsExplanation}" Style="{StaticResource SubtleText}" Margin="0,5,12,0" />
              </StackPanel>
              <Button Grid.Column="1" Content="{Binding RefreshProjectsLabel}" Style="{StaticResource QuietButton}" Click="RefreshProjects_Click" VerticalAlignment="Top" />
            </Grid>
            <TextBlock Text="{Binding ProjectsSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,10,0,3" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ProjectsEmptyMessage}" Margin="0,8,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding HasProjects}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ScrollViewer MaxHeight="135" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,8" Margin="0,3,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding WorkingDirectory}" VerticalContentAlignment="Top" Margin="0,0,12,0">
                          <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding WorkingDirectory}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Normal" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </CheckBox>
                        <TextBlock Grid.Column="1" Text="{Binding SessionSummary}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <Border Grid.Column="1" Width="1" Background="{StaticResource Line}" HorizontalAlignment="Center" />
          <StackPanel Grid.Column="2">
            <TextBlock Text="{Binding TasksTitle}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding TasksExplanation}" Style="{StaticResource SubtleText}" Margin="0,5,0,7" />
            <TextBlock Text="{Binding SelectedProjectsLine}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProjectsLine}" />
            <TextBlock Text="{Binding TasksSummary}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,3" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="135" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding WorkingDirectory}" VerticalContentAlignment="Top">
                        <StackPanel Margin="4,0,0,0">
                          <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" FontSize="10" FontWeight="Normal" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Normal" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                      </CheckBox>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="3" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.88*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
          <StackPanel>
            <TextBlock Text="{Binding ScheduleTitle}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding ScheduleDescription}" Style="{StaticResource SubtleText}" Margin="0,6,0,12" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding ScheduleLabel}" Foreground="{StaticResource Muted}" FontSize="11" />
                <TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" Width="112" Height="38" FontSize="17" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="9,4" Margin="0,6,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Content="{Binding SaveScheduleLabel}" Style="{StaticResource QuietButton}" VerticalAlignment="Bottom" Click="SaveSchedule_Click" />
            </Grid>
            <Border Background="#F4F7F5" CornerRadius="10" Padding="11,8" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="{Binding NextNodeLabel}" Foreground="{StaticResource Muted}" FontSize="10" />
                <TextBlock Text="{Binding NextNodeText}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
          <StackPanel>
            <TextBlock Text="{Binding CliTitle}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CliHint}" Style="{StaticResource SubtleText}" FontSize="11" Margin="0,4,0,8" />
            <TextBox Text="{Binding CodexExecutable, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,3" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding CodexHomeLine}" Style="{StaticResource SubtleText}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CodexHomeLine}" />
              <Button Grid.Column="1" Content="{Binding BrowseLabel}" Style="{StaticResource QuietButton}" Padding="10,7" Margin="7,0,0,0" Click="BrowseCodex_Click" />
              <Button Grid.Column="2" Content="{Binding CliAutoLabel}" Style="{StaticResource QuietButton}" Padding="10,7" Margin="6,0,0,0" Click="AutoCodex_Click" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,6" Padding="14,10">
        <StackPanel>
          <TextBlock Text="{Binding ActivityTitle}" FontSize="16" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding RecentActivity}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7,0,7">
                  <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="5" Text="{Binding Footer}" Foreground="{StaticResource Muted}" FontSize="10" TextAlignment="Center" Margin="0,0,0,4" />
  </Grid>
</Window>
